digraph MCD {
  rankdir=LR;
  bgcolor="#F0F0F0";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=11];

  node [shape=none, margin=0];

  ROLES [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>ROLES</B></TD></TR>
      <TR><TD ALIGN="LEFT"><U>code</U></TD></TR>
      <TR><TD ALIGN="LEFT">libelle</TD></TR>
      <TR><TD ALIGN="LEFT">description</TD></TR>
    </TABLE>>];

  USERS [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>USERS</B></TD></TR>
      <TR><TD ALIGN="LEFT"><U>email</U></TD></TR>
      <TR><TD ALIGN="LEFT">password_hash</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD></TR>
    </TABLE>>];

  PROGRESS [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>PROGRESS</B></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD></TR>
    </TABLE>>];

  MODULES [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>MODULES</B></TD></TR>
      <TR><TD ALIGN="LEFT"><U>title</U></TD></TR>
      <TR><TD ALIGN="LEFT">short_description</TD></TR>
      <TR><TD ALIGN="LEFT">learning_objective</TD></TR>
      <TR><TD ALIGN="LEFT">display_order</TD></TR>
      <TR><TD ALIGN="LEFT">publication_status</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD></TR>
    </TABLE>>];

  RESOURCES [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>RESOURCES</B></TD></TR>
      <TR><TD ALIGN="LEFT"><U>content</U></TD></TR>
      <TR><TD ALIGN="LEFT">resource_type</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD></TR>
    </TABLE>>];

  MODULE_RESOURCES [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#FFF3B0">
      <TR><TD BGCOLOR="#FCE38A"><B>MODULE_RESOURCES</B></TD></TR>
      <TR><TD ALIGN="LEFT">display_order</TD></TR>
    </TABLE>>];

  APossede [label="A pour role", shape=ellipse, style=filled, fillcolor="#4DD9E8", fontsize=11];
  Suit      [label="Suit",      shape=ellipse, style=filled, fillcolor="#4DD9E8", fontsize=11];
  Concerne  [label="Concerne",  shape=ellipse, style=filled, fillcolor="#4DD9E8", fontsize=11];
  Propose   [label="Propose",   shape=ellipse, style=filled, fillcolor="#4DD9E8", fontsize=11];
  Cible     [label="Cible",     shape=ellipse, style=filled, fillcolor="#4DD9E8", fontsize=11];

  USERS -> APossede [label="1,1", dir=none];
  APossede -> ROLES [label="0,n", dir=none];

  USERS -> Suit [label="0,n", dir=none];
  Suit -> PROGRESS [label="1,1", dir=none];

  PROGRESS -> Concerne [label="1,1", dir=none];
  Concerne -> MODULES [label="0,n", dir=none];

  MODULES -> Propose [label="0,n", dir=none];
  Propose -> MODULE_RESOURCES [label="1,1", dir=none];

  MODULE_RESOURCES -> Cible [label="1,1", dir=none];
  Cible -> RESOURCES [label="0,n", dir=none];

  { rank=same; ROLES; USERS; }
  { rank=same; PROGRESS; }
  { rank=same; MODULES; }
  { rank=same; MODULE_RESOURCES; }
  { rank=same; RESOURCES; }
}
