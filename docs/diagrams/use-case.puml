@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

skinparam rectangle {
  BackgroundColor #ADD8E6
  BorderColor Black
  RoundCorner 8
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam actor {
  FontColor Black
}

' Acteurs (cf. docs/SPECS.md §3)
actor "Visiteur·se" as Visitor
actor "Apprenant·e" as Learner
actor "Administrateur·rice" as Admin

' Pile verticale a gauche : Visiteur·se (haut) → Apprenant·e → Administrateur·rice (bas)
Visitor -[hidden]down- Learner
Learner -[hidden]down- Admin

rectangle "Parcours DevOps Guide" {
  ' --- USERS : acquisition de compte ---
  usecase "Creer un compte /\nse connecter" as UC2
  usecase "Consulter la presentation\ndu produit" as UC1

  ' --- MODULES + RESOURCES : parcours apprenant·e ---
  usecase "Consulter la liste\ndes modules" as UC3
  usecase "Consulter le detail\nd'un module et ses ressources" as UC4

  ' --- PROGRESS : suivi individuel ---
  usecase "Consulter sa\nprogression" as UC6
  usecase "Marquer un module\ncomme termine" as UC5

  ' --- MODULES + RESOURCES : administration ---
  usecase "Creer ou modifier\nun module et ses ressources" as UC7
  usecase "Publier ou masquer\nun module" as UC8

  ' Disposition interne proche du schema de reference
  UC2 -[hidden]right- UC1
  UC3 -[hidden]down- UC2
  UC4 -[hidden]right- UC3
  UC6 -[hidden]right- UC4
  UC5 -[hidden]down- UC4
  UC8 -[hidden]down- UC5
  UC7 -[hidden]right- UC8
}

' Visiteur·se
Visitor -- UC1
Visitor -- UC2

' Apprenant·e (herite des cas visiteur·se via generalisation)
Learner -- UC3
Learner -- UC4
Learner -- UC5
Learner -- UC6

' Administrateur·rice (herite des cas apprenant·e)
Admin -- UC7
Admin -- UC8

Visitor <|-- Learner
Learner <|-- Admin

' Publier/masquer suppose un module deja cree ou modifie
UC8 .> UC7 : <<extend>>

@enduml
