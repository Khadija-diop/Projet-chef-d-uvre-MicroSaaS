@startuml
left to right direction
skinparam shadowing false
skinparam linetype ortho

entity "users" as users {
  * id : uuid <<PK>>
  --
  email : text <<UNIQUE>>
  password_hash : text
  role : user_role_enum
  created_at : timestamptz
  updated_at : timestamptz
}

entity "modules" as modules {
  * id : uuid <<PK>>
  --
  title : text
  short_description : text
  learning_objective : text
  display_order : int <<UNIQUE>>
  publication_status : module_publication_status_enum
  created_at : timestamptz
  updated_at : timestamptz
}

entity "resources" as resources {
  * id : uuid <<PK>>
  --
  module_id : uuid <<FK>>
  title : text
  resource_type : resource_type_enum
  url : text
  display_order : int
  created_at : timestamptz
}

entity "progress" as progress {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  module_id : uuid <<FK>>
  status : progress_status_enum
  updated_at : timestamptz
  (user_id, module_id) <<UNIQUE>>
}

users ||--o{ progress : user_id
modules ||--o{ progress : module_id
modules ||--o{ resources : module_id
@enduml
