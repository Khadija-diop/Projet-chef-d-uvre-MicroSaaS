@startuml
left to right direction
skinparam classic true
skinparam shadowing false
skinparam linetype ortho
hide circle

skinparam entity {
  BackgroundColor #F7F7F7
  BorderColor #808080
}

' MPD PostgreSQL : implementation physique du MLD (Parcours DevOps Guide)
' Extension requise : CREATE EXTENSION IF NOT EXISTS pgcrypto;

entity "roles" as roles {
  * id : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  code : varchar(50) <<NOT NULL, UNIQUE>>
  libelle : varchar(100) <<NOT NULL>>
  description : text <<NULL>>
}

entity "users" as users {
  * id : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  email : varchar(255) <<NOT NULL, UNIQUE>>
  password_hash : varchar(255) <<NOT NULL>>
  role_id : uuid <<NOT NULL, FK>> REFERENCES roles(id)
  created_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
  updated_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
}

entity "modules" as modules {
  * id : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  title : varchar(255) <<NOT NULL, UNIQUE>>
  short_description : text <<NOT NULL>>
  learning_objective : text <<NOT NULL>>
  display_order : integer <<NOT NULL, UNIQUE>>
  publication_status : varchar(50) <<NOT NULL>> DEFAULT 'draft'
  created_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
  updated_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
}

entity "resources" as resources {
  * id : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  content : text <<NOT NULL>>
  resource_type : varchar(50) <<NOT NULL>>
  created_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
}

entity "module_resources" as module_resources {
  * module_id : uuid <<PK, FK>> REFERENCES modules(id)
  * resource_id : uuid <<PK, FK>> REFERENCES resources(id)
  --
  display_order : integer <<NOT NULL>> DEFAULT 1
}

entity "progress" as progress {
  * user_id : uuid <<PK, FK>> REFERENCES users(id)
  * module_id : uuid <<PK, FK>> REFERENCES modules(id)
  --
  status : varchar(50) <<NOT NULL>> DEFAULT 'todo'
  updated_at : timestamptz <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
}

roles ||--o{ users
users ||--o{ progress
modules ||--o{ progress
modules ||--o{ module_resources
resources ||--o{ module_resources

@enduml
