@startuml
left to right direction
skinparam classic true
skinparam shadowing false
skinparam linetype ortho
hide circle

skinparam entity {
  BackgroundColor #F7F7F7
  BorderColor #808080
}

' MPD PostgreSQL : implementation physique du MLD (Parcours DevOps Guide)
' Extension requise : CREATE EXTENSION IF NOT EXISTS pgcrypto;

entity "utilisateurs" as utilisateurs {
  * id_user : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  email : varchar(255) <<NOT NULL, UNIQUE>>
  password : varchar(255) <<NOT NULL>>
  role : varchar(50) <<NOT NULL>>
  created_at : timestamp <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
  updated_at : timestamp <<NULL>>
}

entity "modules" as modules {
  * id_module : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  title : varchar(255) <<NOT NULL>>
  short_description : text <<NULL>>
  display_order : integer <<NULL>>
  publication_status_module : varchar(50) <<NULL>>
  learning_objective : text <<NULL>>
  created_at : timestamp <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
  updated_at : timestamp <<NULL>>
}

entity "ressources" as ressources {
  * id_ressources : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  id_module : uuid <<NOT NULL, FK>> REFERENCES modules(id_module)
  content : text <<NOT NULL>>
  resource_type : varchar(50) <<NOT NULL>>
  display_order : integer <<NULL>>
  created_at : timestamp <<NOT NULL>> DEFAULT CURRENT_TIMESTAMP
}

entity "progression" as progression {
  * id_progression : uuid <<PK>> DEFAULT gen_random_uuid()
  --
  id_module : uuid <<NOT NULL, FK>> REFERENCES modules(id_module)
  id_user : uuid <<NOT NULL, FK>> REFERENCES utilisateurs(id_user)
  status : varchar(50) <<NOT NULL>>
  updated_at : timestamp <<NULL>>
}

utilisateurs ||--o{ progression
modules ||--o{ progression
modules ||--o{ ressources

@enduml
